+//! R&D: foveated Tight encoding for first-person shooters.
+//!
+//! For each test frame and strategy, this encodes one full-screen update the
+//! way TopVNC's server would (Fill / palette / JPEG per rectangle, on the
+//! session's encoder threads, bands emitted in order), decodes it the way the
+//! viewer would (JPEG on decoder threads, applied in wire order), and reports
+//! bytes, encode and decode time, the time until the center (fovea) region
+//! is ready, and CPU cost. Decoded frames are written for quality scoring.
+//!
+//! cargo run --release --example fovea_study -- FRAMES_DIR OUT_DIR [NAMES...]
+
+use std::collections::HashMap;
+use std::io::{Cursor, Write};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, mpsc};
+use std::time::{Duration, Instant};
+use topvnc::tight::{self, SamplingFactor, TightDecoder, TightSettings};
+
+const TILE: usize = 64;
+const WIDTH: usize = 1920;
+const HEIGHT: usize = 1080;
+const RUNS: usize = 25;
+const WARMUP: usize = 4;
+const DECODE_THREADS: usize = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Transform {
+    None,
+    /// Low-pass the rectangle (2x2 box down, bilinear up) before JPEG.
+    /// Standard Tight: any viewer decodes it.
+    Prefilter,
+    /// Send the rectangle at half width and height; the viewer upscales.
+    /// Needs a TopVNC-specific encoding.
+    HalfRes,
+}
+
+#[derive(Clone, Copy)]
+struct ZoneSpec {
+    quality: u8,
+    sampling: SamplingFactor,
+    transform: Transform,
+    optimize_huffman: bool,
+}
+
+const fn zone(quality: u8, sampling: SamplingFactor) -> ZoneSpec {
+    ZoneSpec {
+        quality,
+        sampling,
+        transform: Transform::None,
+        optimize_huffman: false,
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Layout {
+    /// TopVNC 0.2 + spec 007: full-width bands of this many rows, top to
+    /// bottom.
+    Bands(usize),
+    /// 64x64 tiles merged only within a zone, at most `band_rows` rows per
+    /// zone, sent fovea first (or row-major).
+    Zoned {
+        band_rows: [usize; 3],
+        order: Order,
+    },
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Order {
+    RowMajor,
+    /// Fovea, then mid, then periphery, each nearest the center first.
+    CenterFirst,
+    /// Fovea nearest the center first, then the rest largest first, which
+    /// balances the encoder threads.
+    FoveaThenLargest,
+}
+
+struct Strategy {
+    name: &'static str,
+    layout: Layout,
+    zones: [ZoneSpec; 3],
+    /// Zone half-sizes as fractions of the frame height: fovea, mid.
+    boxes: [(f64, f64); 2],
+}
+
+const STANDARD: [(f64, f64); 2] = [(0.30, 0.18), (0.60, 0.36)];
+
+/// Zone boxes as half-sizes in pixels around the frame center.
+#[derive(Clone, Copy)]
+struct Geometry {
+    width: usize,
+    height: usize,
+    fovea: (f64, f64),
+    mid: (f64, f64),
+}
+
+impl Geometry {
+    /// The zone of a tile, from its center: 0 fovea, 1 mid, 2 periphery.
+    fn zone(&self, x: usize, y: usize, w: usize, h: usize) -> u8 {
+        let dx = ((x as f64 + w as f64 / 2.0) - self.width as f64 / 2.0).abs();
+        let dy = ((y as f64 + h as f64 / 2.0) - self.height as f64 / 2.0).abs();
+        if dx < self.fovea.0 && dy < self.fovea.1 {
+            0
+        } else if dx < self.mid.0 && dy < self.mid.1 {
+            1
+        } else {
+            2
+        }
+    }
+
+    fn tile_zones(&self) -> Vec<u8> {
+        let mut zones = Vec::new();
+        for ty in 0..self.height.div_ceil(TILE) {
+            for tx in 0..self.width.div_ceil(TILE) {
+                let (x, y) = (tx * TILE, ty * TILE);
+                zones.push(self.zone(x, y, TILE.min(self.width - x), TILE.min(self.height - y)));
+            }
+        }
+        zones
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Rect {
+    x: usize,
+    y: usize,
+    w: usize,
+    h: usize,
+    zone: u8,
+    /// Whether the rectangle overlaps a fovea tile.
+    touches_fovea: bool,
+}
+
+fn rects_for(layout: Layout, g: &Geometry, standard: &Geometry) -> Vec<Rect> {
+    let zones = g.tile_zones();
+    let standard_zones = standard.tile_zones();
+    let columns = g.width.div_ceil(TILE);
+    let overlaps_fovea = |x: usize, y: usize, w: usize, h: usize| {
+        (y / TILE..(y + h).div_ceil(TILE))
+            .any(|ty| {
+                (x / TILE..(x + w).div_ceil(TILE)).any(|tx| standard_zones[ty * columns + tx] == 0)
+            })
+    };
+    match layout {
+        Layout::Bands(rows) => (0..g.height)
+            .step_by(rows)
+            .map(|y| {
+                let h = rows.min(g.height - y);
+                Rect {
+                    x: 0,
+                    y,
+                    w: g.width,
+                    h,
+                    zone: 2,
+                    touches_fovea: overlaps_fovea(0, y, g.width, h),
+                }
+            })
+            .collect(),
+        Layout::Zoned { band_rows, order } => {
+            let mut runs: Vec<Rect> = Vec::new();
+            for ty in 0..g.height.div_ceil(TILE) {
+                for tx in 0..columns {
+                    let (x, y) = (tx * TILE, ty * TILE);
+                    let (w, h) = (TILE.min(g.width - x), TILE.min(g.height - y));
+                    let zone = zones[ty * columns + tx];
+                    if let Some(last) = runs.last_mut()
+                        && last.y == y
+                        && last.zone == zone
+                        && last.x + last.w == x
+                        && last.w + w <= tight::MAX_RECT_WIDTH
+                    {
+                        last.w += w;
+                        last.touches_fovea |= standard_zones[ty * columns + tx] == 0;
+                    } else {
+                        runs.push(Rect {
+                            x,
+                            y,
+                            w,
+                            h,
+                            zone,
+                            touches_fovea: standard_zones[ty * columns + tx] == 0,
+                        });
+                    }
+                }
+            }
+            let mut merged: Vec<Rect> = Vec::new();
+            let mut open: HashMap<(usize, usize, usize, u8), usize> = HashMap::new();
+            for run in runs {
+                if let Some(index) = open.remove(&(run.x, run.w, run.y, run.zone))
+                    && merged[index].h + run.h <= band_rows[usize::from(run.zone)]
+                {
+                    merged[index].h += run.h;
+                    merged[index].touches_fovea |= run.touches_fovea;
+                    open.insert((run.x, run.w, run.y + run.h, run.zone), index);
+                    continue;
+                }
+                open.insert((run.x, run.w, run.y + run.h, run.zone), merged.len());
+                merged.push(run);
+            }
+            let distance = |r: &Rect| {
+                let dx = (r.x * 2 + r.w) as i64 - g.width as i64;
+                let dy = (r.y * 2 + r.h) as i64 - g.height as i64;
+                dx * dx + dy * dy
+            };
+            match order {
+                Order::RowMajor => {}
+                Order::CenterFirst => merged.sort_by_key(|r| (r.zone, distance(r))),
+                Order::FoveaThenLargest => merged.sort_by_key(|r| {
+                    if r.zone == 0 {
+                        (0, distance(r))
+                    } else {
+                        (1, -((r.w * r.h) as i64))
+                    }
+                }),
+            }
+            merged
+        }
+    }
+}
+
+fn copy_rect(frame: &[u32], stride: usize, r: &Rect) -> Vec<u32> {
+    let mut pixels = Vec::with_capacity(r.w * r.h);
+    for row in r.y..r.y + r.h {
+        pixels.extend_from_slice(&frame[row * stride + r.x..row * stride + r.x + r.w]);
+    }
+    pixels
+}
+
+fn channels(p: u32) -> [u32; 3] {
+    [p >> 16 & 0xff, p >> 8 & 0xff, p & 0xff]
+}
+
+/// 2x2 box average to ceil(w/2) x ceil(h/2).
+fn down2(pixels: &[u32], w: usize, h: usize) -> (Vec<u32>, usize, usize) {
+    let (w2, h2) = (w.div_ceil(2), h.div_ceil(2));
+    let mut out = Vec::with_capacity(w2 * h2);
+    for y in 0..h2 {
+        let (y0, y1) = (2 * y, (2 * y + 1).min(h - 1));
+        for x in 0..w2 {
+            let (x0, x1) = (2 * x, (2 * x + 1).min(w - 1));
+            let mut sum = [0u32; 3];
+            for p in [
+                pixels[y0 * w + x0],
+                pixels[y0 * w + x1],
+                pixels[y1 * w + x0],
+                pixels[y1 * w + x1],
+            ] {
+                let c = channels(p);
+                for i in 0..3 {
+                    sum[i] += c[i];
+                }
+            }
+            out.push((sum[0] + 2) / 4 << 16 | (sum[1] + 2) / 4 << 8 | (sum[2] + 2) / 4);
+        }
+    }
+    (out, w2, h2)
+}
+
+/// Bilinear 2x upscale of a `w2` x `h2` image to `w` x `h`, pixel-center aligned.
+fn up2(small: &[u32], w2: usize, h2: usize, w: usize, h: usize) -> Vec<u32> {
+    // Source index pairs and weights (in quarters) per output coordinate.
+    let taps = |n: usize, n2: usize| -> Vec<(usize, usize)> {
+        (0..n)
+            .map(|i| {
+                let k = i / 2;
+                if i % 2 == 0 {
+                    // Between k-1 (1/4) and k (3/4).
+                    (k.saturating_sub(1), k.min(n2 - 1))
+                } else {
+                    // Between k (3/4) and k+1 (1/4).
+                    ((k + 1).min(n2 - 1), k.min(n2 - 1))
+                }
+            })
+            .collect()
+    };
+    let xs = taps(w, w2);
+    let ys = taps(h, h2);
+    let mut out = Vec::with_capacity(w * h);
+    for &(ya, yb) in &ys {
+        for &(xa, xb) in &xs {
+            // (a, b): a weighted 1/4, b weighted 3/4.
+            let p = |yy: usize, xx: usize| channels(small[yy * w2 + xx]);
+            let (aa, ab, ba, bb) = (p(ya, xa), p(ya, xb), p(yb, xa), p(yb, xb));
+            let mut c = [0u32; 3];
+            for i in 0..3 {
+                // Weights: (1/4,1/4)=1, (1/4,3/4)=3, (3/4,1/4)=3, (3/4,3/4)=9; sum 16.
+                c[i] = (aa[i] + 3 * ab[i] + 3 * ba[i] + 9 * bb[i] + 8) / 16;
+            }
+            out.push(c[0] << 16 | c[1] << 8 | c[2]);
+        }
+    }
+    out
+}
+
+struct Job {
+    rect: Rect,
+    settings: TightSettings,
+    transform: Transform,
+}
+
+/// Encode one rectangle: returns the Tight body and the encoded size.
+fn encode_job(frame: &[u32], stride: usize, job: &Job) -> (Vec<u8>, usize, usize) {
+    let r = &job.rect;
+    let pixels = copy_rect(frame, stride, r);
+    let mut body = Vec::new();
+    match job.transform {
+        Transform::None => {
+            tight::encode_rect(&pixels, r.w, r.h, job.settings, &mut body).unwrap();
+            (body, r.w, r.h)
+        }
+        Transform::Prefilter => {
+            let (small, w2, h2) = down2(&pixels, r.w, r.h);
+            let smooth = up2(&small, w2, h2, r.w, r.h);
+            tight::encode_rect(&smooth, r.w, r.h, job.settings, &mut body).unwrap();
+            (body, r.w, r.h)
+        }
+        Transform::HalfRes => {
+            let (small, w2, h2) = down2(&pixels, r.w, r.h);
+            tight::encode_rect(&small, w2, h2, job.settings, &mut body).unwrap();
+            (body, w2, h2)
+        }
+    }
+}
+
+type Task = Arc<dyn Fn() + Send + Sync>;
+
+/// Persistent worker threads, like TopVNC's encoder and decoder pools, so
+/// no thread starts inside a timed region.
+struct Pool {
+    senders: Vec<mpsc::Sender<Task>>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl Pool {
+    fn new(threads: usize) -> Self {
+        let mut pool = Pool {
+            senders: Vec::new(),
+            workers: Vec::new(),
+        };
+        for _ in 0..threads {
+            let (sender, receiver) = mpsc::channel::<Task>();
+            pool.workers.push(std::thread::spawn(move || {
+                for task in receiver {
+                    task();
+                }
+            }));
+            pool.senders.push(sender);
+        }
+        pool
+    }
+
+    /// Run `task` once on every worker.
+    fn run(&self, task: Task) {
+        for sender in &self.senders {
+            sender.send(Arc::clone(&task)).unwrap();
+        }
+    }
+}
+
+impl Drop for Pool {
+    fn drop(&mut self) {
+        self.senders.clear();
+        for worker in self.workers.drain(..) {
+            let _ = worker.join();
+        }
+    }
+}
+
+struct EncodeRun {
+    bodies: Vec<(Vec<u8>, usize, usize)>,
+    total: Duration,
+    /// When every rectangle touching the fovea, and every one before it in
+    /// wire order, was ready to send.
+    fovea_ready: Duration,
+    first_ready: Duration,
+}
+
+/// Encode on the pool's workers, which claim rectangles in order, emitting
+/// bodies in order as TopVNC's encoder pool does.
+fn encode_parallel(pool: &Pool, frame: &Arc<Vec<u32>>, jobs: &Arc<Vec<Job>>) -> EncodeRun {
+    let next = Arc::new(AtomicUsize::new(0));
+    let (sender, receiver) = mpsc::channel();
+    let started = Instant::now();
+    {
+        let (frame, jobs, next) = (Arc::clone(frame), Arc::clone(jobs), Arc::clone(&next));
+        pool.run(Arc::new(move || {
+            loop {
+                let index = next.fetch_add(1, Ordering::Relaxed);
+                let Some(job) = jobs.get(index) else { break };
+                let result = encode_job(&frame, WIDTH, job);
+                if sender.send((index, result)).is_err() {
+                    break;
+                }
+            }
+        }));
+    }
+    let count = jobs.len();
+    let last_fovea = jobs.iter().rposition(|job| job.rect.touches_fovea).unwrap_or(0);
+    let mut done: Vec<Option<(Vec<u8>, usize, usize)>> = (0..count).map(|_| None).collect();
+    let mut bodies = Vec::with_capacity(count);
+    let (mut fovea_ready, mut first_ready) = (Duration::ZERO, Duration::ZERO);
+    while bodies.len() < count {
+        let (index, body) = receiver.recv().unwrap();
+        done[index] = Some(body);
+        while let Some(body) = done.get_mut(bodies.len()).and_then(Option::take) {
+            if bodies.is_empty() {
+                first_ready = started.elapsed();
+            }
+            if bodies.len() == last_fovea {
+                fovea_ready = started.elapsed();
+            }
+            bodies.push(body);
+        }
+    }
+    EncodeRun {
+        bodies,
+        total: started.elapsed(),
+        fovea_ready,
+        first_ready,
+    }
+}
+
+struct DecodeRun {
+    frame: Vec<u32>,
+    total: Duration,
+    fovea_applied: Duration,
+}
+
+thread_local! {
+    static DECODER: std::cell::RefCell<TightDecoder> = std::cell::RefCell::new(TightDecoder::new());
+}
+
+fn decode_body(body: &[u8], w: usize, h: usize, full: (usize, usize)) -> Vec<u32> {
+    let mut bgrx = Vec::new();
+    DECODER.with(|decoder| {
+        decoder
+            .borrow_mut()
+            .read_rect(&mut Cursor::new(body), w, h, &mut bgrx)
+            .unwrap()
+    });
+    let pixels: Vec<u32> = bgrx
+        .chunks_exact(4)
+        .map(|p| u32::from(p[2]) << 16 | u32::from(p[1]) << 8 | u32::from(p[0]))
+        .collect();
+    if (w, h) == full {
+        pixels
+    } else {
+        up2(&pixels, w, h, full.0, full.1)
+    }
+}
+
+/// Decode on the pool's workers and apply in wire order, as the viewer does.
+fn decode_parallel(pool: &Pool, run: &EncodeRun, jobs: &[Job]) -> DecodeRun {
+    let bodies = Arc::new(run.bodies.clone());
+    let rects: Arc<Vec<Rect>> = Arc::new(jobs.iter().map(|job| job.rect).collect());
+    let next = Arc::new(AtomicUsize::new(0));
+    let (sender, receiver) = mpsc::channel();
+    let mut frame = vec![0u32; WIDTH * HEIGHT];
+    let started = Instant::now();
+    {
+        let (bodies, rects, next) = (Arc::clone(&bodies), Arc::clone(&rects), Arc::clone(&next));
+        pool.run(Arc::new(move || {
+            loop {
+                let index = next.fetch_add(1, Ordering::Relaxed);
+                let Some((body, w, h)) = bodies.get(index) else { break };
+                let r = rects[index];
+                let pixels = decode_body(body, *w, *h, (r.w, r.h));
+                if sender.send((index, pixels)).is_err() {
+                    break;
+                }
+            }
+        }));
+    }
+    let count = jobs.len();
+    let last_fovea = jobs.iter().rposition(|job| job.rect.touches_fovea).unwrap_or(0);
+    let mut done: Vec<Option<Vec<u32>>> = (0..count).map(|_| None).collect();
+    let mut applied = 0;
+    let mut fovea_applied = Duration::ZERO;
+    while applied < count {
+        let (index, pixels) = receiver.recv().unwrap();
+        done[index] = Some(pixels);
+        while let Some(pixels) = done.get_mut(applied).and_then(Option::take) {
+            let r = rects[applied];
+            for row in 0..r.h {
+                frame[(r.y + row) * WIDTH + r.x..(r.y + row) * WIDTH + r.x + r.w]
+                    .copy_from_slice(&pixels[row * r.w..(row + 1) * r.w]);
+            }
+            if applied == last_fovea {
+                fovea_applied = started.elapsed();
+            }
+            applied += 1;
+        }
+    }
+    DecodeRun {
+        frame,
+        total: started.elapsed(),
+        fovea_applied,
+    }
+}
+
+/// Bytes of JPEG headers and tables in a Tight JPEG body (everything except
+/// the entropy-coded scan), or 0 for other subencodings.
+fn jpeg_overhead(body: &[u8]) -> usize {
+    if body.first().map(|c| c >> 4) != Some(0x09) {
+        return 0;
+    }
+    // Skip the control byte and the compact length.
+    let mut start = 1;
+    while body[start] & 0x80 != 0 && start < 3 {
+        start += 1;
+    }
+    start += 1;
+    let jpeg = &body[start..];
+    let sos = jpeg.windows(2).position(|w| w == [0xff, 0xda]).unwrap();
+    let sos_length = usize::from(jpeg[sos + 2]) << 8 | usize::from(jpeg[sos + 3]);
+    start + sos + 2 + sos_length + 2
+}
+
+fn median(mut values: Vec<Duration>) -> f64 {
+    values.sort();
+    values[values.len() / 2].as_secs_f64() * 1000.0
+}
+
+fn load(dir: &str, name: &str) -> Vec<u32> {
+    let bytes = std::fs::read(format!("{dir}/{name}.rgb")).unwrap();
+    assert_eq!(bytes.len(), WIDTH * HEIGHT * 3, "{name} must be 1920x1080 RGB");
+    bytes
+        .chunks_exact(3)
+        .map(|p| u32::from(p[0]) << 16 | u32::from(p[1]) << 8 | u32::from(p[2]))
+        .collect()
+}
+
+/// The panning grainy landscape from `latency_bench`, frame 1.
+fn synthetic() -> Vec<u32> {
+    let (width, height) = (WIDTH, HEIGHT);
+    let texture_width = width * 2;
+    let mut seed = 0x9e37_79b9u32;
+    let mut texture = Vec::with_capacity(texture_width * height);
+    for y in 0..height {
+        for x in 0..texture_width {
+            let (fx, fy) = (x as f32, y as f32);
+            let horizon = height as f32 * (0.45 + 0.08 * (fx * 0.004).sin());
+            seed ^= seed << 13;
+            seed ^= seed >> 17;
+            seed ^= seed << 5;
+            let grain = (seed % 13) as f32 - 6.0;
+            let (red, green, blue) = if fy < horizon {
+                let t = fy / horizon;
+                let cloud = 18.0 * ((fx * 0.011).sin() * (fy * 0.03).cos());
+                (90.0 + 60.0 * t + cloud, 140.0 + 50.0 * t + cloud, 230.0 - 20.0 * t)
+            } else {
+                let t = (fy - horizon) / (height as f32 - horizon);
+                let rows = 25.0 * ((fx * 0.05 + fy * 0.21).sin() * (fy * 0.07).cos());
+                (70.0 + 40.0 * t + rows, 120.0 + 30.0 * t + rows, 50.0 + 20.0 * t + rows * 0.5)
+            };
+            let channel = |value: f32| (value + grain).clamp(0.0, 255.0) as u32;
+            texture.push(channel(red) << 16 | channel(green) << 8 | channel(blue));
+        }
+    }
+    let offset = 7;
+    let mut frame = Vec::with_capacity(width * height);
+    for y in 0..height {
+        frame.extend_from_slice(&texture[y * texture_width + offset..y * texture_width + offset + width]);
+    }
+    frame
+}
+
+fn strategies() -> Vec<Strategy> {
+    use SamplingFactor::{R_4_2_0, R_4_2_2, R_4_4_4};
+    let level = |l: usize| {
+        let (quality, sampling) = tight::JPEG_LEVELS[l];
+        zone(quality, sampling)
+    };
+    // The prototype server's layout: 64-row fovea rectangles, 128 elsewhere.
+    let zoned = Layout::Zoned {
+        band_rows: [64, 128, 128],
+        order: Order::CenterFirst,
+    };
+    let with = |mut spec: ZoneSpec, transform| {
+        spec.transform = transform;
+        spec
+    };
+    let optimized = |mut spec: ZoneSpec| {
+        spec.optimize_huffman = true;
+        spec
+    };
+    let balanced = [level(6), level(4), level(1)];
+    let s = |name, layout, zones| Strategy {
+        name,
+        layout,
+        zones,
+        boxes: STANDARD,
+    };
+    vec![
+        s("U6 bands (today)", Layout::Bands(64), [level(6); 3]),
+        s("U3 bands", Layout::Bands(64), [level(3); 3]),
+        s("U6 4:2:2 bands", Layout::Bands(64), [zone(79, R_4_2_2); 3]),
+        s("U6 zoned, center first", zoned, [level(6); 3]),
+        s("F balanced 6/4/1", zoned, balanced),
+        s("F sharp 8/5/2", zoned, [level(8), level(5), level(2)]),
+        s("F wifi 5/3/0", zoned, [level(5), level(3), level(0)]),
+        s(
+            "F 4:2:0 everywhere 6/4/1",
+            zoned,
+            [zone(79, R_4_2_0), zone(62, R_4_2_0), zone(29, R_4_2_0)],
+        ),
+        s(
+            "F balanced + prefilter",
+            zoned,
+            [level(6), level(4), with(level(1), Transform::Prefilter)],
+        ),
+        s(
+            "F balanced + half-res periph",
+            zoned,
+            [level(6), level(4), with(level(1), Transform::HalfRes)],
+        ),
+        s(
+            "F sharp + half-res mid/periph",
+            zoned,
+            [
+                level(8),
+                with(zone(86, R_4_4_4), Transform::HalfRes),
+                with(zone(62, R_4_2_0), Transform::HalfRes),
+            ],
+        ),
+        s(
+            "F balanced, optimized Huffman",
+            zoned,
+            balanced.map(optimized),
+        ),
+        s(
+            "F balanced, opt. Huffman periph",
+            zoned,
+            [level(6), level(4), optimized(level(1))],
+        ),
+        s(
+            "U6 bands, optimized Huffman",
+            Layout::Bands(64),
+            [optimized(level(6)); 3],
+        ),
+        s(
+            "F balanced, row-major order",
+            Layout::Zoned {
+                band_rows: [64, 128, 128],
+                order: Order::RowMajor,
+            },
+            balanced,
+        ),
+        s(
+            "F balanced, large rects 128/256/256",
+            Layout::Zoned {
+                band_rows: [128, 256, 256],
+                order: Order::CenterFirst,
+            },
+            balanced,
+        ),
+        s(
+            "F balanced, fovea 64 + largest first",
+            Layout::Zoned {
+                band_rows: [64, 256, 256],
+                order: Order::FoveaThenLargest,
+            },
+            balanced,
+        ),
+        Strategy {
+            name: "F balanced, small zones",
+            layout: zoned,
+            zones: balanced,
+            boxes: [(0.20, 0.12), (0.45, 0.27)],
+        },
+        Strategy {
+            name: "F balanced, large zones",
+            layout: zoned,
+            zones: balanced,
