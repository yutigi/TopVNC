+/// With a periphery interval N, periphery tiles ride along with every Nth
+/// update that carries fovea or mid tiles, and stay pending otherwise. An
+/// update with only periphery changes goes out once N host frame intervals
+/// passed since the periphery was last sent.
+fn skip_periphery(
+    shared: &Arc<Mutex<ServerFramebuffer>>,
+    update: &mut PreparedUpdate,
+    encoder: &mut SessionEncoder,
+) -> io::Result<()> {
+    let Some(foveation) = encoder.foveation.filter(|f| f.periphery_interval > 1) else {
+        return Ok(());
+    };
+    let fb = shared
+        .lock()
+        .map_err(|_| invalid("framebuffer lock is poisoned"))?;
+    let frame = (fb.framebuffer.width(), fb.framebuffer.height());
+    let periphery = |index: usize| foveation.zone(fb.tile_rect(index), frame) == 2;
+    let has_center = update
+        .rectangles
+        .iter()
+        .any(|rect| !rect.tile_index.is_some_and(periphery));
+    let due = if has_center {
+        encoder.updates_since_periphery + 1 >= foveation.periphery_interval
+    } else {
+        let wait = Duration::from_secs_f64(
+            encoder.adaptive.frame_interval.max(1.0 / 240.0)
+                * f64::from(foveation.periphery_interval),
+        );
+        encoder
+            .periphery_sent_at
+            .is_none_or(|at| at.elapsed() >= wait)
+    };
+    if due {
+        encoder.updates_since_periphery = 0;
+        encoder.periphery_sent_at = Some(Instant::now());
+        return Ok(());
+    }
+    if has_center {
+        encoder.updates_since_periphery += 1;
+    }
+    update
+        .rectangles
+        .retain(|rect| !rect.tile_index.is_some_and(periphery));
+    update.acknowledged.retain(|(index, _)| !periphery(*index));
+    Ok(())
 }
 
+/// Split changed rectangles at the 64-pixel tile grid, give each piece its
+/// tile's zone, and merge pieces only within a zone: horizontally along a
+/// tile row, then vertically up to the zone's band height. Returns
+/// rectangles with their zones, fovea first and nearest the center first
+/// when `center_first` is set.
+fn foveated_rects(
+    rects: &[ServerRect],
+    frame: (usize, usize),
+    foveation: &Foveation,
+) -> Vec<(usize, usize, usize, usize, u8)> {
+    let mut pieces: Vec<(usize, usize, usize, usize, u8)> = Vec::new();
+    for rect in rects {
+        let (x0, y0) = (usize::from(rect.x), usize::from(rect.y));
+        let (x1, y1) = (x0 + usize::from(rect.width), y0 + usize::from(rect.height));
+        for tile_y in (y0 / SERVER_TILE_SIZE)..y1.div_ceil(SERVER_TILE_SIZE) {
+            for tile_x in (x0 / SERVER_TILE_SIZE)..x1.div_ceil(SERVER_TILE_SIZE) {
+                let (tx, ty) = (tile_x * SERVER_TILE_SIZE, tile_y * SERVER_TILE_SIZE);
+                let tile = (
+                    tx,
+                    ty,
+                    SERVER_TILE_SIZE.min(frame.0 - tx),
+                    SERVER_TILE_SIZE.min(frame.1 - ty),
+                );
+                let (px0, py0) = (tx.max(x0), ty.max(y0));
+                let (px1, py1) = ((tx + tile.2).min(x1), (ty + tile.3).min(y1));
+                if px0 < px1 && py0 < py1 {
+                    pieces.push((px0, py0, px1 - px0, py1 - py0, foveation.zone(tile, frame)));
+                }
+            }
+        }
+    }
+    pieces.sort_by_key(|&(x, y, ..)| (y, x));
+    let mut runs: Vec<(usize, usize, usize, usize, u8)> = Vec::new();
+    for piece in pieces {
+        if let Some(last) = runs.last_mut()
+            && last.1 == piece.1
+            && last.3 == piece.3
+            && last.4 == piece.4
+            && last.0 + last.2 == piece.0
+            && last.2 + piece.2 <= tight::MAX_RECT_WIDTH
+        {
+            last.2 += piece.2;
+        } else {
+            runs.push(piece);
+        }
+    }
+    let mut merged: Vec<(usize, usize, usize, usize, u8)> = Vec::with_capacity(runs.len());
+    let mut open = std::collections::HashMap::new();
+    for (x, y, width, height, zone) in runs {
+        let limit = foveation.band_rows[usize::from(zone)].clamp(1, tight::MAX_RECT_HEIGHT);
+        if let Some(index) = open.remove(&(x, width, y, zone)) {
+            let above: &mut (usize, usize, usize, usize, u8) = &mut merged[index];
+            if above.3 + height <= limit {
+                above.3 += height;
+                open.insert((x, width, y + height, zone), index);
+                continue;
+            }
+        }
+        open.insert((x, width, y + height, zone), merged.len());
+        merged.push((x, y, width, height, zone));
+    }
+    if foveation.center_first {
+        let distance = |&(x, y, w, h, _): &(usize, usize, usize, usize, u8)| {
+            let dx = (x * 2 + w) as i64 - frame.0 as i64;
+            let dy = (y * 2 + h) as i64 - frame.1 as i64;
+            dx * dx + dy * dy
+        };
+        merged.sort_by_key(|rect| (rect.4, distance(rect)));
+    }
+    merged
+}
