+#[derive(Default)]
+struct Adaptive {
+    preset: usize,
+    /// Updates sent since the preset changed.
+    updates: u32,
+    /// Bytes per update at the current preset, smoothed.
+    bytes: f64,
+    /// Seconds between host frames, smoothed, and the last frame count seen.
+    frame_interval: f64,
+    last_frames: Option<(u64, Instant)>,
+}
+
+impl SessionEncoder {
+    /// Track the host's frame rate from its frame counter.
+    fn observe_frames(&mut self, frames: u64, now: Instant) {
+        let adaptive = &mut self.adaptive;
+        match adaptive.last_frames {
+            Some((last, at)) if frames > last => {
+                let sample = now.saturating_duration_since(at).as_secs_f64() / (frames - last) as f64;
+                adaptive.frame_interval = if adaptive.frame_interval == 0.0 {
+                    sample
+                } else {
+                    0.9 * adaptive.frame_interval + 0.1 * sample
+                };
+                adaptive.last_frames = Some((frames, now));
+            }
+            None => adaptive.last_frames = Some((frames, now)),
+            _ => {}
+        }
+    }
+
+    /// After an update of `bytes`, move to a more compact preset when frames
+    /// outgrow the link, or a sharper one when it clearly fits.
+    fn adapt(&mut self, bytes: usize, throughput: Option<f64>) {
+        let Some(foveation) = self.foveation.as_mut().filter(|f| f.adaptive) else {
+            return;
+        };
+        let state = &mut self.adaptive;
+        if state.updates == 0 && state.bytes == 0.0 {
+            state.preset = 1;
+        }
+        state.bytes = if state.updates == 0 {
+            bytes as f64
+        } else {
+            0.8 * state.bytes + 0.2 * bytes as f64
+        };
+        state.updates += 1;
+        if let (Some(rate), true) = (throughput, state.frame_interval > 0.0) {
+            let budget = rate * state.frame_interval.max(1.0 / 480.0) * 0.8;
+            if state.bytes > budget && state.preset + 1 < ADAPTIVE_PRESETS.len() && state.updates >= 4 {
+                state.preset += 1;
+                state.updates = 0;
+            } else if state.preset > 0
+                && state.updates >= 60
+                && state.bytes * ADAPTIVE_GROWTH[state.preset - 1] < budget * 0.85
+            {
+                state.preset -= 1;
+                state.updates = 0;
+            }
+        }
+        let (zones, interval) = ADAPTIVE_PRESETS[state.preset];
+        foveation.zones = zones;
+        foveation.periphery_interval = interval;
+    }
+}
