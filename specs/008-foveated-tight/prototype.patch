+/// Zones around the framebuffer center, where a shooter's crosshair is.
+/// Each 64x64 tile belongs to the zone its center falls in.
+#[derive(Clone, Copy, Debug)]
+pub struct Foveation {
+    /// Half-width and half-height of the fovea box, as fractions of the
+    /// framebuffer height.
+    pub fovea: (f32, f32),
+    /// Half-width and half-height of the mid box.
+    pub mid: (f32, f32),
+    /// JPEG quality (1-100) and chroma subsampling for the fovea, mid, and
+    /// periphery.
+    pub zones: [(u8, tight::SamplingFactor); 3],
+    /// Most rows per rectangle in each zone.
+    pub band_rows: [usize; 3],
+    /// Send the zones in this order: fovea first, nearest the center first.
+    /// Otherwise row-major, as without foveation.
+    pub center_first: bool,
+    /// Send periphery tiles with every Nth update only; 1 sends them always.
+    pub periphery_interval: u32,
+    /// Step through [`ADAPTIVE_PRESETS`] so a frame's bytes stay within 80%
+    /// of what the link carries in one host frame interval, measured by
+    /// continuous-update flow control. Starts at the second preset.
+    pub adaptive: bool,
+}
+
+/// Presets for adaptive foveation, sharpest first: zone qualities and the
+/// periphery interval.
+pub const ADAPTIVE_PRESETS: [([(u8, tight::SamplingFactor); 3], u32); 5] = {
+    use tight::SamplingFactor::{R_4_2_0, R_4_2_2, R_4_4_4};
+    [
+        ([(92, R_4_4_4), (77, R_4_2_2), (41, R_4_2_0)], 1),
+        ([(79, R_4_4_4), (62, R_4_2_2), (29, R_4_2_0)], 1),
+        ([(77, R_4_2_2), (42, R_4_2_2), (15, R_4_2_0)], 1),
+        ([(77, R_4_2_2), (42, R_4_2_2), (15, R_4_2_0)], 2),
+        ([(62, R_4_2_2), (29, R_4_2_0), (15, R_4_2_0)], 2),
+    ]
+};
+/// Approximate bytes of each preset relative to the next one, measured on
+/// five FPS screenshots; used to predict whether a sharper preset fits.
+const ADAPTIVE_GROWTH: [f64; 4] = [1.44, 1.31, 1.18, 1.3];
+
+impl Foveation {
+    /// Zone of the tile at (`x`, `y`) of `width` by `height` pixels in a
+    /// `frame_width` by `frame_height` framebuffer: 0 fovea, 1 mid,
+    /// 2 periphery.
+    fn zone(&self, (x, y, width, height): (usize, usize, usize, usize), frame: (usize, usize)) -> u8 {
+        let dx = ((x * 2 + width) as f32 - frame.0 as f32).abs() / 2.0;
+        let dy = ((y * 2 + height) as f32 - frame.1 as f32).abs() / 2.0;
+        let unit = frame.1 as f32;
+        if dx < self.fovea.0 * unit && dy < self.fovea.1 * unit {
+            0
+        } else if dx < self.mid.0 * unit && dy < self.mid.1 * unit {
+            1
+        } else {
+            2
         }
     }
 }
